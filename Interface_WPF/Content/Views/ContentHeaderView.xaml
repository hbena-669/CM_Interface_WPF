<UserControl x:Class="Interface_WPF.Content.Views.ContentHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:local="clr-namespace:Interface_WPF.Content.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="Blue" BorderThickness="1" Background="#CC6600" CornerRadius="5" Margin="5,0,5,5">
        <DockPanel VerticalAlignment="Center" Height="40" Margin="0,0,10,0">
            <!-- UTILISATEUR À DROITE -->
            <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0">

                <fa:ImageAwesome Icon="UserCircle"
                             Width="22"
                             Height="22"
                             Margin="0,0,5,0"
                             Foreground="White"/>

                <TextBlock Text="{Binding UserName}"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Foreground="White"/>
            </StackPanel>

        </DockPanel>
    </Border>
</UserControl>
