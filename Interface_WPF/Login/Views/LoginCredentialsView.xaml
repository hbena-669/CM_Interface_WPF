<UserControl x:Class="Interface_WPF.Login.Views.LoginCredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:Interface_WPF.Helpers"
             xmlns:converter="clr-namespace:Interface_WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converter:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="300"
                    Margin="20"
                    materialDesign:ElevationAssist.Elevation="Dp2">

            <!-- Titre -->
            <TextBlock Text="Connexion"
                       HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0 0 0 20"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>

            <!-- Message d'erreur -->
            <Border Background="#FFEBEE" 
                    BorderBrush="#F44336" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="12"
                    Margin="0 0 0 16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle" 
                                           Foreground="#C62828" 
                                           VerticalAlignment="Center"
                                           Margin="0 0 8 0"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#C62828" 
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Nom d'utilisateur -->
            <TextBox x:Name="UserName"
                     Margin="0 10"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Nom d'utilisateur" 
                     FontSize="16"
                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

            <!-- Mot de passe -->
            <PasswordBox Margin="0 10"
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                         materialDesign:HintAssist.Hint="Mot de passe"
                         FontSize="16"
                         helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

            <!-- Bouton Continuer avec indicateur de chargement -->
            <Grid Margin="0 20 0 0" Height="40">
                <!-- Bouton normal -->
                <Button x:Name="Continue"
                        Content="Continuer"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Indicateur de chargement -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Width="24"
                                 Height="24"
                                 IsIndeterminate="True"
                                 Margin="0 0 8 0"/>
                    <TextBlock Text="Connexion en cours..."
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>